msgstr "按间隔定时检测，并在清单中显示每台服务器的状态"

msgid "Check error"
msgstr "检测错误"

msgid "Check interval"
msgstr "检测间隔"

msgid "Check interval (s)"
msgstr "检测间隔（秒）"

msgid "Check interval must be between 1 and 86400 s."
msgstr "检测间隔须在 1～86400 秒之间"

msgid "Check ports automatically"
msgstr "自动检测端口状态"

msgid "Check the highlighted settings and try again."
msgstr "请检查设置后重试。"

msgid "Check timeout"
msgstr "单次超时"

msgid "Check timeout (s)"
msgstr "单次超时（秒）"

msgid "Check timeout must be between 1 and 120 s."
msgstr "单次超时须在 1～120 秒之间"

msgid "Check {protocol} {port} after knocking"
msgstr "敲门完成后检测 {protocol} {port}"

msgid "Checking"
msgstr "检测中"

msgid "Choose at least one setting to update."
msgstr "请至少选择一个修改项目"

msgid "Config file  {0}"
msgstr "配置文件  {0}"

msgid "Connection refused"
msgstr "连接被拒绝"

msgid "Could not create the configuration directory: {error}"
msgstr "创建配置目录失败：{error}"

msgid "Could not read the configuration: {error}"
msgstr "读取配置失败：{error}"

msgid "Could not replace the configuration: {error}"
msgstr "替换配置失败：{error}"

msgid "Could not write the configuration: {error}"
msgstr "写入配置失败：{error}"

msgid "Current server only"
msgstr "仅当前服务器"

msgid "Dark"
msgstr "深色"

msgid "Delete"
msgstr "删除"

msgid "Delete server"
msgstr "删除服务器"

msgid "Delete {0} and its local settings?"
msgstr "确认删除“{0}”及其本地配置？"

msgid "Disabled: keep each server's existing port and protocol."
msgstr "未开启：保留各服务器原有的业务检测端口及协议。"

msgid "Display name"
msgstr "显示名称"

msgid "Edit"
msgstr "编辑"

msgid "Edit server"
msgstr "编辑服务器"

msgid "Enter a display name."
msgstr "请填写显示名称"

msgid "Enter a valid IP address or hostname, without a protocol or path."
msgstr "请填写有效的 IP 或域名，不包含协议前缀或路径"

msgid "Every 30 s"
msgstr "每 30 秒"

msgid "Every {seconds}s"
msgstr "每 {seconds} 秒"

msgid "Failed: {count}"
msgstr "{count} 台发送失败"

msgid "Follow system"
msgstr "跟随系统"

msgid "Hostname resolution failed: {error}"
msgstr "无法解析服务器地址：{error}"

