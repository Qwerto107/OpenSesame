msgid "+ Add"
msgstr "+ 新增"

msgid "+ Add server"
msgstr "+ 新增服务器"

msgid "+ Add step"
msgstr "+ 添加步骤"

msgid "1  Enter address"
msgstr "1  填写地址"

msgid "2  Set sequence"
msgstr "2  设置敲门序列"

msgid "3  Set service port"
msgstr "3  配置业务端口"

msgid "A connection was established; authentication was not checked."
msgstr "仅表示连接建立，不代表登录成功"

msgid "Add a server, set its knock sequence and service port,\nthen knock and monitor its connection status."
msgstr "添加一台服务器，配置敲门序列和要检测的业务端口，\n之后即可一键开门并随时查看端口状态。"

msgid "Add at least one knock step."
msgstr "请至少添加一个敲门步骤"

msgid "Add server"
msgstr "新增服务器"

msgid "All servers"
msgstr "全部服务器"

msgid "Appearance"
msgstr "外观"

msgid "Apply to {0}"
msgstr "应用到 {0} 台"

msgid "Apply to {0} selected servers. Names and addresses stay unchanged."
msgstr "将应用到已选 {0} 台服务器，名称与地址不会改变"

msgid "Auto-check"
msgstr "自动检测"

msgid "Back to current server"
msgstr "返回当前服务器"

msgid "Basic information"
msgstr "基本信息"

msgid "Batch edit"
msgstr "批量设置"

msgid "Batch knock"
msgstr "批量开门"

msgid "Batch knock completed"
msgstr "批量开门已完成"

msgid "Batch settings"
msgstr "批量设置"

msgid "Cancel"
msgstr "取消"

