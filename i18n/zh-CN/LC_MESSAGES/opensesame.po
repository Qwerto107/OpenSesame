msgstr "服务器地址解析超时"

msgid "IP address or hostname"
msgstr "IP 或域名"

msgid "In {seconds}s"
msgstr "{seconds} 秒后"

msgid "Invalid configuration directory."
msgstr "配置目录无效"

msgid "Invalid configuration; the original file was preserved: {error}"
msgstr "配置格式错误，原文件已保留：{error}"

