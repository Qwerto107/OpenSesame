msgstr "OpenSesame 启动失败：{error}"

msgid "Port monitoring"
msgstr "端口检测"

msgid "Port must be an integer between 1 and 65535."
msgstr "端口须为 1～65535 之间的整数"

msgid "Protocol"
msgstr "检测协议"

msgid "Reachable"
msgstr "可连接"

msgid "Replace the sequence. Each server keeps its step interval and timeout."
msgstr "整体替换原序列；步骤间隔与时间上限保持各服务器原值。"

msgid "Reserved: text/HEX payload and response matching. No response means Unknown, not Closed."
msgstr "预留：探测内容（文本／HEX）与响应判断规则。无响应时将显示“无法确认”，不会判定为关闭。"

msgid "Responded"
msgstr "有响应"

msgid "Save"
msgstr "保存"

msgid "Select at least one server."
msgstr "请先勾选服务器"

msgid "Select {0}"
msgstr "勾选 {0}"

msgid "Selected: {0}"
msgstr "已选 {0} 台"

msgid "Selected: {0} · Checks run after knocking"
msgstr "已选 {0} 台 · 敲门完成后自动检测业务端口"

msgid "Send failed"
msgstr "发送失败"

msgid "Send failed · {error}"
msgstr "发送失败 · {error}"

msgid "Sending a sequence does not confirm access. Check the service port status below."
msgstr "“已发送”不等于开门成功，请以下方端口检测结果为准。"

msgid "Sending step {current} / {total}"
msgstr "正在发送第 {current} / {total} 步"

msgid "Sent: {sent} · Reachable: {reachable} · Unknown: {unknown}"
msgstr "{sent} 台敲门序列已发送 · {reachable} 台端口可连接 · {unknown} 台无法确认"

msgid "Sequence sent · Steps: {current} / {total}"
msgstr "敲门序列已发送 · {current} / {total} 步"

msgid "Sequence timed out. Check the address, interval and timeout."
msgstr "序列发送超时，请检查地址、间隔及时间上限"

msgid "Sequence timeout"
msgstr "序列时间上限"

msgid "Sequence timeout (s)"
msgstr "序列时间上限（秒）"

msgid "Sequence timeout must be between 1 and 300 s."
msgstr "序列时间上限须在 1～300 秒之间"

msgid "Server ID cannot be empty."
msgstr "服务器标识不能为空"

msgid "Server address"
msgstr "服务器地址"

msgid "Servers"
msgstr "服务器"

msgid "Service check"
msgstr "业务检测"

msgid "Service port"
msgstr "业务端口"

msgid "Service port must be between 1 and 65535."
msgstr "业务端口须在 1～65535 之间"

msgid "Service port status"
msgstr "业务端口状态"

msgid "Settings"
msgstr "设置"

msgid "Some servers no longer exist. Select them again."
msgstr "部分服务器已不存在，请重新选择"

msgid "Startup"
msgstr "启动"

msgid "Step interval"
msgstr "步骤间隔"

msgid "Step interval (ms)"
msgstr "步骤间隔（毫秒）"

msgid "Step interval must be between 10 and 60000 ms."
msgstr "步骤间隔须在 10～60000 毫秒之间"

msgid "TCP reachable"
msgstr "TCP 可连接"

msgid "The configuration contains duplicate server IDs."
msgstr "配置包含重复服务器标识"

msgid "The knock sequence cannot be empty."
msgstr "敲门序列不能为空"

msgid "The original configuration was preserved. Fix the file and restart the app."
msgstr "配置读取失败，原文件已保留；修复配置文件后重新打开程序。"

msgid "The selected servers changed. Select them again."
msgstr "所选服务器已发生变化，请重新选择"

msgid "The sequence exceeds its timeout. Increase the timeout or shorten the interval."
msgstr "序列时间上限不足以发送全部步骤，请增大上限或缩短间隔"

msgid "The target replied with {bytes} bytes; authentication was not checked."
msgstr "目标端口已回复 {bytes} 字节；未验证业务认证"

msgid "The window is closed."
msgstr "窗口已关闭"

msgid "Timed out"
msgstr "检测超时"

msgid "UDP probe"
msgstr "UDP 探测"

msgid "UDP probe (available for UDP)"
msgstr "UDP 探测（选择 UDP 协议后启用）"

msgid "UDP responded"
msgstr "UDP 有响应"

msgid "Unknown"
msgstr "无法确认"

msgid "Unsupported configuration version: {version}"
msgstr "不支持的配置版本：{version}"

msgid "Update knock sequence"
msgstr "更新敲门序列"

msgid "Update service port"
msgstr "更新业务检测端口"

msgid "Waiting for the first check"
msgstr "等待首次检测"

msgid "Windows AppData was not found."
msgstr "未找到 Windows AppData 目录"

msgid "e.g. Home NAS"
msgstr "例如：家庭 NAS"

msgid "{field} must be a positive integer."
msgstr "{field}须为有效的正整数"

msgid "{name}: {error}"
msgstr "{name}：{error}"

msgid "{sent} / {total} sent"
msgstr "{sent} / {total} 已发送"

msgid "{time}  Sequence sent · Steps: {steps} · Time: {elapsed}s"
msgstr "{time}  敲门序列已发送（{steps} 步，耗时 {elapsed} 秒）"

msgid "{time}  {error}"
msgstr "{time}  {error}"

