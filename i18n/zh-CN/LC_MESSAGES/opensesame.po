msgstr "敲门中…"

msgid "Language"
msgstr "语言"

msgid "Last checked"
msgstr "最近检测"

msgid "Light"
msgstr "亮色"

msgid "Monitoring scope"
msgstr "检测范围"

msgid "Network operation failed: {error}"
msgstr "网络操作失败：{error}"

msgid "Next check"
msgstr "下次检测"

msgid "No connection was established within the configured timeout."
msgstr "在配置的超时时间内未能建立连接"

msgid "No response received; this does not mean the port is closed."
msgstr "未收到响应，不代表端口关闭"

msgid "No servers"
msgstr "暂无服务器"

msgid "No servers yet"
msgstr "还没有服务器"

msgid "No usable address was found for this hostname."
msgstr "服务器地址没有可用的解析结果"

msgid "Not checked"
msgstr "未检测"

msgid "Not knocked yet"
msgstr "尚未敲门"

msgid "Off"
msgstr "已关闭"

