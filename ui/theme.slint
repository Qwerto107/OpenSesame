export global Palette {
    in-out property <bool> dark: true;
    out property <color> canvas: dark ? #0B0F17 : #F4F7FB;
    out property <color> sidebar: dark ? #0D121C : #EEF2F8;
    out property <color> titlebar: dark ? #080B12 : #FFFFFF;
    out property <color> card: dark ? #121826 : #FFFFFF;
    out property <color> inset: dark ? #0B1220 : #F1F5FA;
    out property <color> border: dark ? #1F2937 : #D8DFEA;
    out property <color> control-border: dark ? #2A3548 : #CBD5E1;
    out property <color> button: dark ? #161E2E : #FFFFFF;
    out property <color> text: dark ? #E5E7EB : #0F172A;
    out property <color> muted: dark ? #9CA3AF : #475569;
    out property <color> accent: dark ? #22D3EE : #06B6D4;
    out property <color> accent-text: dark ? #67E8F9 : #0E7490;
    out property <color> selected: dark ? #0E2A33 : #E0F7FB;
    out property <color> segment: dark ? #0E3A47 : #CFFAFE;
    out property <color> green: dark ? #34D399 : #047857;
    out property <color> green-bg: dark ? #0F2E25 : #D1FAE5;
    out property <color> amber: dark ? #FBBF24 : #92400E;
    out property <color> amber-bg: dark ? #2E2410 : #FEF3C7;
    out property <color> red: dark ? #F87171 : #B91C1C;
}

